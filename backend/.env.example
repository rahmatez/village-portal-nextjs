NODE_ENV=development
PORT=4000
# Homebrew PostgreSQL (Mac): gunakan user sistem Anda, mis. postgresql://rahmatez@localhost:5432/desa_mindaka
# Docker: postgresql://postgres:postgres@localhost:5432/desa_mindaka
DATABASE_URL=postgresql://rahmatez@localhost:5432/desa_mindaka?schema=public
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
